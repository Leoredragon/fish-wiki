{
  "appId": "com.oltaapp.app",
  "appName": "OltaApp",
  "webDir": "public",
  "server": {
    "url": "https://www.oltaapp.com",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "buildOptions": {
      "keystorePath": "",
      "keystorePassword": ""
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
