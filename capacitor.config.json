{
  "appId": "com.oltaapp.app",
  "appName": "OltaApp",
  "webDir": "public",
  "server": {
    "url": "https://www.oltaapp.com",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0F172A",
    "buildOptions": {
      "keystorePath": "",
      "keystorePassword": ""
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0F172A"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
